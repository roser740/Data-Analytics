    "def invertir_paraules(frase):\n",
    "paraules = frase.split()\n",
    "frase2 = paraules.reverse()\n",
    "return frase2\n",
    "\n",
    "\n",
    "print(invertir_paraules(\"hola mundo Python\")) # Python mundo hola"
   ]
